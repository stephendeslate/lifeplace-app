[
  {
    "model": "communications.communicationtemplate",
    "pk": 100,
    "fields": {
      "created_at": "2025-01-11T00:00:00.000Z",
      "updated_at": "2025-01-11T00:00:00.000Z",
      "name": "Payment Receipt",
      "channel": "EMAIL",
      "category": "SYSTEM",
      "subject_template": "Payment Receipt #{{ receipt_number }} - {{ payment_amount_formatted }}",
      "body_template": "<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 700px; margin: 0 auto; border: 1px solid #e0e0e0;\">\n    <!-- Header -->\n    <div style=\"background: linear-gradient(135deg, #28a745 0%, #20c997 100%); padding: 40px 30px; text-align: center;\">\n        <h1 style=\"color: white; margin: 0; font-size: 32px; font-weight: 300;\">Payment Received</h1>\n        <p style=\"color: rgba(255,255,255,0.9); margin-top: 10px; font-size: 16px;\">Thank you for your payment!</p>\n    </div>\n    \n    <!-- Content -->\n    <div style=\"padding: 40px 30px; background: white;\">\n        <p style=\"color: #333; font-size: 16px; line-height: 1.6; margin-bottom: 25px;\">\n            Dear {{ client_name }},\n        </p>\n        \n        <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin-bottom: 30px;\">\n            We have received your payment of <strong>{{ payment_amount_formatted }}</strong>. Thank you for your prompt payment!\n        </p>\n        \n        <!-- Receipt Details -->\n        <div style=\"background: #f8f9fa; padding: 25px; margin: 30px 0; border-radius: 8px;\">\n            <div style=\"display: flex; justify-content: space-between; align-items: start; margin-bottom: 20px;\">\n                <h2 style=\"color: #333; margin: 0; font-size: 20px;\">Payment Details</h2>\n                <span style=\"background: #28a745; color: white; padding: 5px 15px; border-radius: 20px; font-size: 14px; font-weight: 600;\">{{ payment_status }}</span>\n            </div>\n            \n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Receipt Number:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">#{{ receipt_number }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Payment Number:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ payment_number }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Payment Date:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ payment_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Payment Method:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ payment_method }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Event:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ event_name }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666;\">Event Date:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right;\">{{ event_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 15px 0 10px 0; color: #666; font-size: 18px;\">Amount Paid:</td>\n                    <td style=\"padding: 15px 0 10px 0; color: #28a745; font-weight: bold; text-align: right; font-size: 24px;\">{{ payment_amount_formatted }}</td>\n                </tr>\n            </table>\n        </div>\n        \n        {% if remaining_balance_formatted and remaining_balance != '0' %}\n        <!-- Remaining Balance -->\n        <div style=\"background: #fff3cd; border: 1px solid #ffc107; padding: 20px; margin: 30px 0; border-radius: 4px;\">\n            <h3 style=\"color: #856404; margin-top: 0; font-size: 16px;\">Remaining Balance</h3>\n            <p style=\"color: #856404; margin: 10px 0; line-height: 1.6;\">\n                Your remaining balance is <strong>{{ remaining_balance_formatted }}</strong>.\n            </p>\n        </div>\n        {% endif %}\n        \n        <!-- Download Receipt -->\n        {% if receipt_link %}\n        <div style=\"text-align: center; margin: 40px 0;\">\n            <a href=\"{{ receipt_link }}\" style=\"background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 15px 40px; text-decoration: none; border-radius: 30px; font-size: 16px; font-weight: 600; display: inline-block; box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);\">\n                Download Receipt\n            </a>\n        </div>\n        {% endif %}\n        \n        <p style=\"color: #666; font-size: 14px; line-height: 1.6; margin-top: 30px;\">\n            If you have any questions about this payment, please contact us.\n        </p>\n    </div>\n    \n    <!-- Footer -->\n    <div style=\"background: #f8f9fa; padding: 30px; text-align: center; border-top: 1px solid #e0e0e0;\">\n        <p style=\"color: #666; margin: 5px 0; font-size: 14px;\">{{ site_name }}</p>\n        <p style=\"color: #999; margin: 5px 0; font-size: 13px;\">Thank you for your business!</p>\n        <p style=\"color: #999; margin: 15px 0 5px 0; font-size: 12px;\">{{ current_year }} {{ site_name }}. All rights reserved.</p>\n    </div>\n</div>",
      "is_system": true,
      "context_type": "PAYMENT",
      "include_client_context": false,
      "include_event_context": false
    }
  },
  {
    "model": "communications.communicationtemplate",
    "pk": 101,
    "fields": {
      "created_at": "2025-01-11T00:00:00.000Z",
      "updated_at": "2025-01-11T00:00:00.000Z",
      "name": "Payment Reminder",
      "channel": "EMAIL",
      "category": "SYSTEM",
      "subject_template": "Payment Reminder: {{ payment_amount_formatted }} Due {{ payment_due_date }}",
      "body_template": "<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 700px; margin: 0 auto; border: 1px solid #e0e0e0;\">\n    <!-- Header -->\n    <div style=\"background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%); padding: 40px 30px; text-align: center;\">\n        <h1 style=\"color: white; margin: 0; font-size: 32px; font-weight: 300;\">Payment Reminder</h1>\n        <p style=\"color: rgba(255,255,255,0.9); margin-top: 10px; font-size: 16px;\">Your payment is coming due</p>\n    </div>\n    \n    <!-- Content -->\n    <div style=\"padding: 40px 30px; background: white;\">\n        <p style=\"color: #333; font-size: 16px; line-height: 1.6; margin-bottom: 25px;\">\n            Dear {{ client_name }},\n        </p>\n        \n        <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin-bottom: 30px;\">\n            This is a friendly reminder that your payment of <strong>{{ payment_amount_formatted }}</strong> is due on <strong>{{ payment_due_date }}</strong>.\n        </p>\n        \n        <!-- Payment Details -->\n        <div style=\"background: #f8f9fa; padding: 25px; margin: 30px 0; border-radius: 8px;\">\n            <h2 style=\"color: #333; margin-top: 0; font-size: 20px; margin-bottom: 20px;\">Payment Details</h2>\n            \n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Payment Number:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ payment_number }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Event:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ event_name }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Event Date:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ event_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666;\">Due Date:</td>\n                    <td style=\"padding: 10px 0; color: #fd7e14; font-weight: 600; text-align: right;\">{{ payment_due_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 15px 0 10px 0; color: #666; font-size: 18px;\">Amount Due:</td>\n                    <td style=\"padding: 15px 0 10px 0; color: #333; font-weight: bold; text-align: right; font-size: 24px;\">{{ payment_amount_formatted }}</td>\n                </tr>\n            </table>\n        </div>\n        \n        <!-- Call to Action -->\n        <div style=\"text-align: center; margin: 40px 0;\">\n            <a href=\"{{ dashboard_url }}\" style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px 40px; text-decoration: none; border-radius: 30px; font-size: 16px; font-weight: 600; display: inline-block; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);\">\n                Make Payment\n            </a>\n        </div>\n        \n        <p style=\"color: #666; font-size: 14px; line-height: 1.6; margin-top: 30px;\">\n            If you have already made this payment, please disregard this reminder. If you have any questions, please don't hesitate to contact us.\n        </p>\n    </div>\n    \n    <!-- Footer -->\n    <div style=\"background: #f8f9fa; padding: 30px; text-align: center; border-top: 1px solid #e0e0e0;\">\n        <p style=\"color: #666; margin: 5px 0; font-size: 14px;\">{{ site_name }}</p>\n        <p style=\"color: #999; margin: 15px 0 5px 0; font-size: 12px;\">{{ current_year }} {{ site_name }}. All rights reserved.</p>\n    </div>\n</div>",
      "is_system": true,
      "context_type": "PAYMENT",
      "include_client_context": false,
      "include_event_context": false
    }
  },
  {
    "model": "communications.communicationtemplate",
    "pk": 102,
    "fields": {
      "created_at": "2025-01-11T00:00:00.000Z",
      "updated_at": "2025-01-11T00:00:00.000Z",
      "name": "Payment Overdue Notice",
      "channel": "EMAIL",
      "category": "SYSTEM",
      "subject_template": "Payment Overdue: {{ payment_amount_formatted }} - Immediate Action Required",
      "body_template": "<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 700px; margin: 0 auto; border: 1px solid #e0e0e0;\">\n    <!-- Header -->\n    <div style=\"background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); padding: 40px 30px; text-align: center;\">\n        <h1 style=\"color: white; margin: 0; font-size: 32px; font-weight: 300;\">Payment Overdue</h1>\n        <p style=\"color: rgba(255,255,255,0.9); margin-top: 10px; font-size: 16px;\">Immediate action required</p>\n    </div>\n    \n    <!-- Content -->\n    <div style=\"padding: 40px 30px; background: white;\">\n        <p style=\"color: #333; font-size: 16px; line-height: 1.6; margin-bottom: 25px;\">\n            Dear {{ client_name }},\n        </p>\n        \n        <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin-bottom: 30px;\">\n            Your payment of <strong>{{ payment_amount_formatted }}</strong> was due on <strong>{{ payment_due_date }}</strong> and is now overdue. Please make this payment as soon as possible to avoid any issues with your booking.\n        </p>\n        \n        <!-- Warning Box -->\n        <div style=\"background: #f8d7da; border: 1px solid #f5c6cb; padding: 20px; margin: 30px 0; border-radius: 4px;\">\n            <h3 style=\"color: #721c24; margin-top: 0; font-size: 16px;\">Important Notice</h3>\n            <p style=\"color: #721c24; margin: 10px 0; line-height: 1.6;\">\n                Late payments may affect your booking status and could incur additional fees. Please make your payment immediately to avoid any complications.\n            </p>\n        </div>\n        \n        <!-- Payment Details -->\n        <div style=\"background: #f8f9fa; padding: 25px; margin: 30px 0; border-radius: 8px;\">\n            <h2 style=\"color: #333; margin-top: 0; font-size: 20px; margin-bottom: 20px;\">Payment Details</h2>\n            \n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Payment Number:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ payment_number }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Event:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ event_name }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Original Due Date:</td>\n                    <td style=\"padding: 10px 0; color: #dc3545; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ payment_due_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 15px 0 10px 0; color: #666; font-size: 18px;\">Amount Due:</td>\n                    <td style=\"padding: 15px 0 10px 0; color: #dc3545; font-weight: bold; text-align: right; font-size: 24px;\">{{ payment_amount_formatted }}</td>\n                </tr>\n            </table>\n        </div>\n        \n        <!-- Call to Action -->\n        <div style=\"text-align: center; margin: 40px 0;\">\n            <a href=\"{{ dashboard_url }}\" style=\"background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; padding: 15px 40px; text-decoration: none; border-radius: 30px; font-size: 16px; font-weight: 600; display: inline-block; box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);\">\n                Pay Now\n            </a>\n        </div>\n        \n        <p style=\"color: #666; font-size: 14px; line-height: 1.6; margin-top: 30px;\">\n            If you have already made this payment or need to discuss payment arrangements, please contact us immediately.\n        </p>\n    </div>\n    \n    <!-- Footer -->\n    <div style=\"background: #f8f9fa; padding: 30px; text-align: center; border-top: 1px solid #e0e0e0;\">\n        <p style=\"color: #666; margin: 5px 0; font-size: 14px;\">{{ site_name }}</p>\n        <p style=\"color: #999; margin: 15px 0 5px 0; font-size: 12px;\">{{ current_year }} {{ site_name }}. All rights reserved.</p>\n    </div>\n</div>",
      "is_system": true,
      "context_type": "PAYMENT",
      "include_client_context": false,
      "include_event_context": false
    }
  },
  {
    "model": "communications.communicationtemplate",
    "pk": 103,
    "fields": {
      "created_at": "2025-01-11T00:00:00.000Z",
      "updated_at": "2025-01-11T00:00:00.000Z",
      "name": "Invoice Notification",
      "channel": "EMAIL",
      "category": "SYSTEM",
      "subject_template": "Invoice #{{ invoice_number }} - {{ invoice_total_formatted }} Due {{ invoice_due_date }}",
      "body_template": "<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 700px; margin: 0 auto; border: 1px solid #e0e0e0;\">\n    <!-- Header -->\n    <div style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px 30px; text-align: center;\">\n        <h1 style=\"color: white; margin: 0; font-size: 32px; font-weight: 300;\">New Invoice</h1>\n        <p style=\"color: rgba(255,255,255,0.9); margin-top: 10px; font-size: 16px;\">Invoice #{{ invoice_number }}</p>\n    </div>\n    \n    <!-- Content -->\n    <div style=\"padding: 40px 30px; background: white;\">\n        <p style=\"color: #333; font-size: 16px; line-height: 1.6; margin-bottom: 25px;\">\n            Dear {{ client_name }},\n        </p>\n        \n        <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin-bottom: 30px;\">\n            A new invoice has been generated for your event. Please find the details below.\n        </p>\n        \n        <!-- Invoice Details -->\n        <div style=\"background: #f8f9fa; padding: 25px; margin: 30px 0; border-radius: 8px;\">\n            <h2 style=\"color: #333; margin-top: 0; font-size: 20px; margin-bottom: 20px;\">Invoice Details</h2>\n            \n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Invoice Number:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">#{{ invoice_number }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Issue Date:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ invoice_issue_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Due Date:</td>\n                    <td style=\"padding: 10px 0; color: #667eea; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ invoice_due_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Event:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ event_name }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Event Date:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ event_date }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 15px 0 10px 0; color: #666; font-size: 18px;\">Total Amount:</td>\n                    <td style=\"padding: 15px 0 10px 0; color: #667eea; font-weight: bold; text-align: right; font-size: 24px;\">{{ invoice_total_formatted }}</td>\n                </tr>\n            </table>\n        </div>\n        \n        <!-- Line Items -->\n        {% if line_items_summary %}\n        <div style=\"background: #f8f9fa; padding: 25px; margin: 30px 0; border-radius: 8px;\">\n            <h3 style=\"color: #333; margin-top: 0; font-size: 16px; margin-bottom: 15px;\">Line Items</h3>\n            <pre style=\"color: #555; margin: 0; font-family: inherit; white-space: pre-wrap;\">{{ line_items_summary }}</pre>\n        </div>\n        {% endif %}\n        \n        <!-- Call to Action -->\n        <div style=\"text-align: center; margin: 40px 0;\">\n            <a href=\"{{ invoice_link }}\" style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px 40px; text-decoration: none; border-radius: 30px; font-size: 16px; font-weight: 600; display: inline-block; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3); margin-right: 15px;\">\n                View Invoice\n            </a>\n            {% if invoice_pdf_link %}\n            <a href=\"{{ invoice_pdf_link }}\" style=\"background: transparent; color: #667eea; padding: 15px 40px; text-decoration: none; border-radius: 30px; font-size: 16px; font-weight: 600; display: inline-block; border: 2px solid #667eea;\">\n                Download PDF\n            </a>\n            {% endif %}\n        </div>\n        \n        {% if payment_terms %}\n        <div style=\"background: #e7f3ff; border: 1px solid #b3d9ff; padding: 20px; margin: 30px 0; border-radius: 4px;\">\n            <h3 style=\"color: #0066cc; margin-top: 0; font-size: 16px;\">Payment Terms</h3>\n            <p style=\"color: #0066cc; margin: 10px 0; line-height: 1.6;\">{{ payment_terms }}</p>\n        </div>\n        {% endif %}\n        \n        <p style=\"color: #666; font-size: 14px; line-height: 1.6; margin-top: 30px;\">\n            If you have any questions about this invoice, please contact us.\n        </p>\n    </div>\n    \n    <!-- Footer -->\n    <div style=\"background: #f8f9fa; padding: 30px; text-align: center; border-top: 1px solid #e0e0e0;\">\n        <p style=\"color: #666; margin: 5px 0; font-size: 14px;\">{{ site_name }}</p>\n        <p style=\"color: #999; margin: 15px 0 5px 0; font-size: 12px;\">{{ current_year }} {{ site_name }}. All rights reserved.</p>\n    </div>\n</div>",
      "is_system": true,
      "context_type": "INVOICE",
      "include_client_context": false,
      "include_event_context": false
    }
  },
  {
    "model": "communications.communicationtemplate",
    "pk": 104,
    "fields": {
      "created_at": "2025-01-11T00:00:00.000Z",
      "updated_at": "2025-01-11T00:00:00.000Z",
      "name": "Payment Plan Confirmation",
      "channel": "EMAIL",
      "category": "SYSTEM",
      "subject_template": "Payment Plan Confirmed for {{ event_name }}",
      "body_template": "<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 700px; margin: 0 auto; border: 1px solid #e0e0e0;\">\n    <!-- Header -->\n    <div style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px 30px; text-align: center;\">\n        <h1 style=\"color: white; margin: 0; font-size: 32px; font-weight: 300;\">Payment Plan Confirmed</h1>\n        <p style=\"color: rgba(255,255,255,0.9); margin-top: 10px; font-size: 16px;\">Your payment schedule is set up</p>\n    </div>\n    \n    <!-- Content -->\n    <div style=\"padding: 40px 30px; background: white;\">\n        <p style=\"color: #333; font-size: 16px; line-height: 1.6; margin-bottom: 25px;\">\n            Dear {{ client_name }},\n        </p>\n        \n        <p style=\"color: #555; font-size: 15px; line-height: 1.6; margin-bottom: 30px;\">\n            Your payment plan for <strong>{{ event_name }}</strong> has been confirmed. Here are the details of your payment schedule.\n        </p>\n        \n        <!-- Plan Summary -->\n        <div style=\"background: #f8f9fa; padding: 25px; margin: 30px 0; border-radius: 8px;\">\n            <h2 style=\"color: #333; margin-top: 0; font-size: 20px; margin-bottom: 20px;\">Payment Plan Summary</h2>\n            \n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Total Amount:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ plan_total_amount }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Down Payment:</td>\n                    <td style=\"padding: 10px 0; color: #28a745; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ plan_down_payment }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Number of Installments:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ plan_installments_count }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666; border-bottom: 1px solid #e0e0e0;\">Payment Frequency:</td>\n                    <td style=\"padding: 10px 0; color: #333; font-weight: 600; text-align: right; border-bottom: 1px solid #e0e0e0;\">{{ plan_frequency }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 10px 0; color: #666;\">Next Payment:</td>\n                    <td style=\"padding: 10px 0; color: #667eea; font-weight: 600; text-align: right;\">{{ plan_next_payment_date }} - {{ plan_next_payment_amount }}</td>\n                </tr>\n            </table>\n        </div>\n        \n        <!-- Progress Bar -->\n        <div style=\"background: #f8f9fa; padding: 25px; margin: 30px 0; border-radius: 8px;\">\n            <h3 style=\"color: #333; margin-top: 0; font-size: 16px; margin-bottom: 15px;\">Payment Progress</h3>\n            <div style=\"background: #e9ecef; border-radius: 10px; height: 20px; overflow: hidden;\">\n                <div style=\"background: linear-gradient(135deg, #28a745 0%, #20c997 100%); height: 100%; width: {{ plan_completion_percentage }}; transition: width 0.3s ease;\"></div>\n            </div>\n            <p style=\"color: #666; font-size: 14px; margin-top: 10px; text-align: center;\">{{ plan_completion_percentage }} complete - {{ plan_remaining_installments }} installments remaining</p>\n        </div>\n        \n        <!-- Call to Action -->\n        <div style=\"text-align: center; margin: 40px 0;\">\n            <a href=\"{{ dashboard_url }}\" style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px 40px; text-decoration: none; border-radius: 30px; font-size: 16px; font-weight: 600; display: inline-block; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);\">\n                View Payment Schedule\n            </a>\n        </div>\n        \n        <p style=\"color: #666; font-size: 14px; line-height: 1.6; margin-top: 30px;\">\n            We'll send you a reminder before each payment is due. If you have any questions, please contact us.\n        </p>\n    </div>\n    \n    <!-- Footer -->\n    <div style=\"background: #f8f9fa; padding: 30px; text-align: center; border-top: 1px solid #e0e0e0;\">\n        <p style=\"color: #666; margin: 5px 0; font-size: 14px;\">{{ site_name }}</p>\n        <p style=\"color: #999; margin: 15px 0 5px 0; font-size: 12px;\">{{ current_year }} {{ site_name }}. All rights reserved.</p>\n    </div>\n</div>",
      "is_system": true,
      "context_type": "PAYMENT",
      "include_client_context": false,
      "include_event_context": false
    }
  },
