# LifePlace Load Testing Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Target Environment
# =============================================================================

# API base URL (without trailing slash)
LOAD_TEST_BASE_URL=https://api.yourdomain.com

# WebSocket URL (usually same as API URL but with wss://)
LOAD_TEST_WS_URL=wss://api.yourdomain.com

# =============================================================================
# REQUIRED - Test Credentials
# Create dedicated test accounts, don't use real admin/client accounts
# =============================================================================

# Admin test account (role: ADMIN, is_staff: True)
LOAD_TEST_ADMIN_EMAIL=loadtest-admin@yourdomain.com
LOAD_TEST_ADMIN_PASSWORD=your-secure-admin-password

# Client test account (role: CLIENT)
LOAD_TEST_CLIENT_EMAIL=loadtest-client@yourdomain.com
LOAD_TEST_CLIENT_PASSWORD=your-secure-client-password

# =============================================================================
# OPTIONAL - Booking Flow Testing
# Get these IDs from your database for more accurate testing
# =============================================================================

# ID of a booking flow to use for testing
# Get from: SELECT id FROM bookingflow_bookingflow WHERE is_active=true LIMIT 1;
LOAD_TEST_BOOKING_FLOW_ID=

# ID of a venue to use for testing
# Get from: SELECT id FROM venues_venue WHERE is_active=true LIMIT 1;
LOAD_TEST_VENUE_ID=

# ID of a package to use for testing
# Get from: SELECT id FROM products_product WHERE product_type='PACKAGE' AND is_active=true LIMIT 1;
LOAD_TEST_PACKAGE_ID=

# ID of an event type to use for testing
# Get from: SELECT id FROM events_eventtype WHERE is_active=true LIMIT 1;
LOAD_TEST_EVENT_TYPE_ID=
