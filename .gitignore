# Ignore files and directories that should not be tracked by Git

# Dependencies
node_modules/

# Environment files (may contain secrets)
.env
.env.local
.env.production
**/.env
**/.env.local
**/.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
venv/
backend/venv/

# Celery Beat
celerybeat-schedule*

# Database files
*.sqlite3

# Media uploads (test artifacts)
backend/media/

# Django collected static files
backend/staticfiles/

# macOS
.DS_Store

# IDE
.idea/

# Test coverage
coverage/
**/coverage/
*.lcov
.coverage

# Log files
*.log

# Test artifacts
backend/test_message.json

# Build artifacts
dist/
build/
*.tar.gz
*.tsbuildinfo

# Root package-lock (workspace lock files in each app are tracked instead)
/package-lock.json

# Turborepo
.turbo/

# Export scripts and output
export_files.py
export_concatenated_files.py
export/
export-concatenated/

# Load test reports
backend/load_tests/*_report.html