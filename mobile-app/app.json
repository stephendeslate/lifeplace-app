{
  "expo": {
    "name": "LifePlace",
    "slug": "lifeplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifeplace.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LifePlace needs camera access to upload photos for your event.",
        "NSPhotoLibraryUsageDescription": "LifePlace needs photo library access to upload photos for your event."
      },
      "associatedDomains": [
        "applinks:app.lifeplace.com",
        "applinks:*.lifeplace.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F7"
      },
      "package": "com.lifeplace.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.lifeplace.com",
              "pathPrefix": "/actions"
            },
            {
              "scheme": "https",
              "host": "app.lifeplace.com",
              "pathPrefix": "/quotes"
            },
            {
              "scheme": "https",
              "host": "app.lifeplace.com",
              "pathPrefix": "/contracts"
            },
            {
              "scheme": "https",
              "host": "app.lifeplace.com",
              "pathPrefix": "/payments"
            },
            {
              "scheme": "https",
              "host": "app.lifeplace.com",
              "pathPrefix": "/events"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.lifeplace.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "lifeplace"
  }
}
