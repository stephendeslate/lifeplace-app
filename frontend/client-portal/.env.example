# Client Portal Environment Variables
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_URL=http://localhost:8000
# For production, use your actual API URL:
# VITE_API_URL=https://api.yourdomain.com

# Stripe Configuration (required for payment processing)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
# For production, use your live Stripe key:
# VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_live_key_here

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking (optional, for production)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags
VITE_ENABLE_GUEST_BOOKING=true
VITE_ENABLE_ACCOUNT_CREATION=true
VITE_ENABLE_PAYMENT_PLANS=false
VITE_ENABLE_SOCIAL_LOGIN=false
VITE_ENABLE_PAYPAL=false
VITE_ENABLE_PODCASTS=true
VITE_ENABLE_HELP_CENTER=false

# Environment
VITE_ENV=development
# Options: development, staging, production

# Debug Mode
VITE_DEBUG=false

# API Timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# Max File Upload Size (in bytes)
VITE_MAX_FILE_SIZE=10485760  # 10MB

# Session Configuration
VITE_SESSION_TIMEOUT=30  # minutes
VITE_BOOKING_SESSION_TIMEOUT=60  # minutes for booking flow
VITE_AUTO_SAVE_INTERVAL=30  # seconds

# UI Configuration
VITE_ENABLE_ANIMATIONS=true
VITE_MOBILE_BREAKPOINT=768  # pixels
VITE_ENABLE_PWA=true

# Booking Configuration
VITE_MIN_BOOKING_LEAD_TIME=24  # hours
VITE_MAX_BOOKING_ADVANCE_TIME=365  # days
VITE_DEFAULT_GUEST_COUNT=50

# Payment Configuration
VITE_MIN_DEPOSIT_PERCENTAGE=25
VITE_ENABLE_PAYMENT_METHODS=card,bank_transfer,payment_plan

# Security
VITE_ENABLE_RECAPTCHA=false
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# External Services
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_CALENDAR_INTEGRATION=google,outlook

# Performance
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_TIMEOUT=300  # seconds

# Development Tools
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true
VITE_ENABLE_REDUX_DEVTOOLS=false