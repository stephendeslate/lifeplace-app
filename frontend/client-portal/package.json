{
  "name": "client-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && cp build/client/__spa-fallback.html build/client/200.html",
    "preview": "react-router serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:changed": "vitest related",
    "test:integration": "vitest run --testTimeout=10000 src/**/*.integration.test.*",
    "audit:security": "npm audit --audit-level=high",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,css}'"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.1.1",
    "@mui/lab": "^7.0.0-beta.16",
    "@mui/material": "^7.1.1",
    "@mui/x-date-pickers": "^8.5.0",
    "@react-oauth/google": "^0.13.4",
    "@react-router/node": "^7.13.0",
    "@sentry/react": "^8.47.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.4.0",
    "@tanstack/react-query": "^5.80.5",
    "@tanstack/react-query-devtools": "^5.80.5",
    "axios": "^1.13.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.3.1",
    "isbot": "^5",
    "libphonenumber-js": "^1.12.37",
    "lodash": "^4.17.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "signature_pad": "^5.1.0",
    "yet-another-react-lightbox": "^3.29.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@react-router/dev": "^7.13.0",
    "@sentry/vite-plugin": "^4.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/axios": "^0.14.4",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^26.1.0",
    "ts-jest": "^29.4.6",
    "ts-unused-exports": "^11.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "unimported": "^1.31.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
