# lifeplace-app/.env.production
# This file contains production environment variables for Railway deployment

# Environment
ENV=production

# Django Secret Key - Generate a new secure key for production
SECRET_KEY=s-d0-qi*u#ybea^ya!f1fncs2)0!akiy@(1fvvf$!tv*(onmtr

# Debug (always False in production)
DEBUG=False

# Database (Railway will provide this automatically)
DATABASE_URL=postgresql://username:password@host:port/database

# Allowed Hosts (Railway will provide your app URL)
ALLOWED_HOSTS=your-app-name.railway.app

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://your-app-name.railway.app

# CORS Allowed Origins (Your Netlify URLs)
CORS_ALLOWED_ORIGINS=https://your-admin-crm.netlify.app,https://your-client-portal.netlify.app